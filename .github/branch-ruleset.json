{
  "name": "enterprise-main-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main",
        "refs/heads/master"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Rust Workspace Quality Gate"
          },
          {
            "context": "Documentation Link & Claims Gate"
          },
          {
            "context": "Frontend Quality Gate"
          },
          {
            "context": "IEEE/ACM Scientific Reproducibility Gate"
          },
          {
            "context": "OpenAPI 3.1 & Python SDK Packaging Gate"
          },
          {
            "context": "Helm & Deployment Manifest Verification Gate"
          },
          {
            "context": "TLA+ Model Checking Gate"
          },
          {
            "context": "Two-Replica Redis Streams Invalidation Gate"
          },
          {
            "context": "Windows Console & Encoding Gate"
          },
          {
            "context": "Apply every migration to a real PostgreSQL"
          }
        ]
      }
    }
  ]
}
