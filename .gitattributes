# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit LF for codebase files
*.json text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
