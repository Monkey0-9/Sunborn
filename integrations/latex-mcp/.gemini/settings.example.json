{
  "mcpServers": {
    "sunborn-paper": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "integrations/latex-mcp",
        "sunborn-latex-mcp"
      ],
      "timeout": 30000,
      "trust": false,
      "includeTools": [
        "latex_workspace_list",
        "latex_read_file",
        "latex_create_file",
        "latex_update_file",
        "latex_validate_project",
        "latex_compile_pdf"
      ]
    }
  }
}
