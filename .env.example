# Server
PORT=8080
HOST=0.0.0.0
RUST_LOG=info,sunborn=debug,tower_http=debug
SUNBORN_ENV=development

# Storage & cache backends (production requires dragonfly/postgres/qdrant)
SUNBORN_CACHE_BACKEND=memory
SUNBORN_DB_BACKEND=memory
SUNBORN_VECTOR_BACKEND=memory
SUNBORN_STRICT_DURABILITY=false
POSTGRES_URL=postgres://sunborn:sunborn_dev_password@localhost:5432/sunborn
DRAGONFLY_URL=redis://127.0.0.1:6379
QDRANT_URL=http://127.0.0.1:6333

# Upstream LLM + embeddings (required for production)
SUNBORN_LLM_ORIGIN_URL=
OPENAI_API_KEY=
SUNBORN_EMBEDDING_URL=
SUNBORN_EMBEDDING_API_KEY=
SUNBORN_EMBEDDING_MODEL=text-embedding-3-small

# Crypto / identity (required for production; keys must be distinct)
SUNBORN_MASTER_KEK=
SUNBORN_ADMIN_KEY=
SUNBORN_LEARNING_HMAC_SECRET=
SUNBORN_CERTIFICATE_SIGNING_KEY=
SUNBORN_KMS_PROVIDER=local
AWS_KMS_KEY_ARN=
VAULT_ADDR=
VAULT_TOKEN=

# Lineage: set a Neo4j endpoint to enable transitive invalidation
SUNBORN_NEO4J_URL=
SUNBORN_NEO4J_USER=
SUNBORN_NEO4J_PASSWORD=

# Optional
SUNBORN_CORS_ALLOWED_ORIGINS=http://localhost:3000
