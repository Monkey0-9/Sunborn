      "title": "Sunborn Platform Overview — Golden Signals",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "req/sec",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(sunborn_requests_total[1m]))",
          "legendFormat": "Total Traffic",
          "refId": "A"
        },
        {
          "expr": "sum(rate(sunborn_cache_hits_total{tier=\"exact\"}[1m]))",
          "legendFormat": "Tier-1 Exact Hits (<0.9 µs)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(sunborn_cache_hits_total{tier=\"semantic\"}[1m]))",
          "legendFormat": "Tier-2 Semantic Hits",
          "refId": "C"
        },
        {
          "expr": "sum(rate(sunborn_cache_misses_total[1m]))",
          "legendFormat": "Origin Misses",
          "refId": "D"
        }
      ],
      "title": "Ingress Request Throughput by Tier",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Latency (seconds)",
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "rate(sunborn_request_duration_seconds_total[1m]) / rate(sunborn_requests_total[1m])",
          "legendFormat": "Mean Latency",
          "refId": "A"
        }
      ],
      "title": "Gateway Processing Latency",
      "type": "timeseries"
