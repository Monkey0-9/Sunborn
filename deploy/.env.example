# Sunborn Environment Configuration Template
# DO NOT commit real secrets (.env) to version control.

# Deployment Environment: 'development' or 'production'
SUNBORN_ENV=development

# Authoritative PostgreSQL Database Credentials
POSTGRES_USER=sunborn
POSTGRES_PASSWORD=generate_with_openssl_rand_base64_32
POSTGRES_URL=postgres://sunborn:generate_with_openssl_rand_base64_32@localhost:5432/sunborn

# Cache & Vector Store Endpoints
DRAGONFLY_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# Production Cryptographic Master Key-Encryption Key (32 bytes hex)
# Generate via: openssl rand -hex 32
SUNBORN_MASTER_KEK=generate_with_openssl_rand_hex_32

# Master Administrator API Key (Generate securely for production)
SUNBORN_ADMIN_KEY=generate_with_openssl_rand_hex_32

# Real Upstream LLM Origin & Embedding Service URLs (Required in Production)
SUNBORN_LLM_ORIGIN_URL=https://api.openai.com/v1
SUNBORN_LLM_ORIGIN_API_KEY=your_openai_or_upstream_key_here
SUNBORN_EMBEDDING_URL=https://api.openai.com/v1
SUNBORN_EMBEDDING_API_KEY=your_openai_or_upstream_key_here
SUNBORN_EMBEDDING_MODEL=text-embedding-3-small

# Learning Controller HMAC-SHA256 Verification Secret (Optional; derives from KEK if omitted)
SUNBORN_LEARNING_HMAC_SECRET=generate_with_openssl_rand_hex_32
